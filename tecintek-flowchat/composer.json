{
    "name": "tecintek/flowchat",
    "description": "Tecintek FlowChat - plataforma self-hosted de automatización conversacional (WhatsApp, Instagram, Messenger, Webchat)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": false,
        "sort-packages": true
    },
    "scripts": {
        "lint": "find app bin config public -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
