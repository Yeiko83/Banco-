# =============================================================
#  Tecintek FlowChat — configuración de entorno
#  Copia este archivo a ".env" (fuera de public_html) y complétalo.
#  NUNCA subas .env a Git.
# =============================================================

APP_NAME="Tecintek FlowChat"
APP_ENV=production            # production | local
APP_DEBUG=false               # true sólo en local: muestra trazas de error
APP_URL=https://chat.tecintek.com
APP_TIMEZONE=America/Bogota   # zona para mostrar fechas; la BD siempre guarda UTC
# Clave de 32 bytes en base64 para cifrar tokens de Meta (libsodium).
# Genera una con:  php bin/keygen.php   (o)   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# --- Base de datos (hPanel > Bases de datos > MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_flowchat
DB_USERNAME=u123456789_flowchat
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Sesiones del panel ---
SESSION_NAME=fc_session
SESSION_LIFETIME=720          # minutos
SESSION_SECURE_COOKIE=true    # requiere HTTPS

# --- Meta for Developers (App única para WA + IG + Messenger) ---
META_APP_ID=
META_APP_SECRET=              # valida X-Hub-Signature-256 de los webhooks
META_WEBHOOK_VERIFY_TOKEN=    # string aleatorio que pegas en Meta al registrar el webhook
META_GRAPH_VERSION=v21.0

# --- Cola / cron_worker.php ---
QUEUE_BATCH_SIZE=50           # jobs por ejecución del cron
QUEUE_MAX_RUNTIME=50          # segundos máx. por ejecución (cron corre cada 60s)
QUEUE_LOCK_TIMEOUT=300        # segundos antes de liberar un job "processing" colgado
BROADCAST_BATCH_SIZE=50
FLOW_MAX_STEPS=60             # pasos máx. por ejecución (anti-bucle infinito)

# --- Webhooks salientes (nodo Acción) ---
HTTP_TIMEOUT=10
HTTP_ALLOW_PRIVATE_IPS=false  # bloquea SSRF hacia 127.0.0.1 / 10.x / 192.168.x

# --- Inbox (polling) ---
INBOX_POLL_INTERVAL_MS=3000

# --- Logs ---
LOG_LEVEL=info                # debug | info | warning | error
LOG_RETENTION_DAYS=14
