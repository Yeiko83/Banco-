# === PolyPhoenix — configuración de ejemplo ===
# Copia este archivo a ".env" y ajusta los valores.

# --- Modo ---
# paper = simulación (seguro, por defecto). live = dinero real (NO implementado aún).
MODE=paper
# OFFLINE=1 fuerza el feed sintético sin tocar la red (útil para probar).
OFFLINE=0

# --- Capital ---
# 200.000 COP ≈ 50 USD. Polymarket liquida en USDC (USD). Pon lo REAL a arriesgar.
CAPITAL=50
MONEDA=USD

# --- Agresividad de la estrategia ---
UMBRAL_ENTRADA=60
VENTANA=12
TOP_N=3

# --- Escudos de riesgo ---
STOP_LOSS=0.08
TAKE_PROFIT=0.15
TAMANO_POSICION=0.10
MAX_POSICION_PCT=0.30
MAX_POR_MERCADO_PCT=0.60
DRAWDOWN_DIARIO_MAX=0.08
MAX_POSICIONES=8
MAX_OPS_POR_HORA=12
SPREAD_MAX_PCT=0.05
RATIO_RR_MIN=1.5

# --- Ciclo ---
INTERVALO_SEG=60
LIMITE_MERCADOS=200

# --- Reportes ---
REPORTES_DIR=reportes
# Google Sheets (opcional): ID de la hoja y ruta al JSON de service account.
# GOOGLE_SHEETS_ID=
# GOOGLE_CREDS=credentials.json
