# ============================================================
#  CONFIGURACION DEL AGENTE DE POLYMARKET
#  Copia este archivo a  .env  y rellena tus datos.
#  NUNCA subas el .env real a GitHub (ya esta en .gitignore).
# ============================================================

# --- MODO DE OPERACION ---
# SIM  = simulacion (dinero ficticio, NO arriesga nada). <<< POR DEFECTO
# LIVE = dinero real. Solo cambia esto cuando la simulacion demuestre ganancia neta.
MODE=SIM

# Confirmacion extra obligatoria para operar en real (evita accidentes).
# Debe valer exactamente:  SI_ENTIENDO_EL_RIESGO
LIVE_CONFIRM=

# --- CAPITAL Y RIESGO (en USDC, la moneda real de Polymarket) ---
# 200.000 COP ~ 50 USDC  (ajusta segun la tasa del dia).
CAPITAL_USDC=50
# Tamano maximo por operacion. 6.000 COP ~ 1.5 USDC.
POSITION_SIZE_USDC=1.5
# Si el saldo disponible baja de esto, el agente se PAUSA.
MIN_BALANCE_USDC=1.5
# Tope de operaciones por dia.
MAX_TRADES_PER_DAY=30
# Umbral minimo de "edge"/spread para entrar (0.012 = 1.2%).
MIN_EDGE=0.012
# Cierre forzado si la posicion no da beneficio en X minutos.
POSITION_TIMEOUT_MIN=30
# Objetivo de ganancia por operacion (0.02 = 2%). Al alcanzarlo, cierra.
TAKE_PROFIT=0.02
# Stop-loss del "escudo" (0.03 = -3%). Corta la perdida.
STOP_LOSS=0.03
# Comision estimada por lado (informativa, para el calculo de rentabilidad neta).
FEE_ESTIMATE=0.00

# --- CREDENCIALES POLYMARKET (solo necesarias en modo LIVE) ---
# Clave privada de la wallet de Polygon que uses en Polymarket.
POLY_PRIVATE_KEY=
# Host de la CLOB API (por defecto el oficial).
POLY_CLOB_HOST=https://clob.polymarket.com
POLY_CHAIN_ID=137

# --- BASE DE DATOS MYSQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_mysql
DB_PASSWORD=clave_mysql
DB_NAME=polymarket

# --- REPORTES POR CORREO ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=tu_correo@tudominio.com
SMTP_PASSWORD=clave_correo
REPORT_TO=yeison.rodriguez83@gmail.com
