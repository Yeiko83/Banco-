# Copia este archivo como .env (sin .example) y ajústalo.
# Voz: es-CO-GonzaloNeural (masculina) o es-CO-SalomeNeural (femenina)
TTS_VOICE="es-CO-GonzaloNeural"
TTS_RATE="+5%"
YOUTUBE_CLIENT_SECRETS_FILE="client_secrets.json"
# 22 = People & Blogs, 27 = Education
YOUTUBE_CATEGORY_ID="27"
# private | unlisted | public
YOUTUBE_PRIVACY="private"
# Opcional: clave gratuita de pollinations.ai (sin ella hay que esperar ~16 s entre imágenes)
POLLINATIONS_TOKEN=""
POLLINATIONS_PAUSA="16"
# País para las tendencias de Google Trends (CO, MX, ES, AR, US...)
TENDENCIAS_PAIS="CO"
